{
	"name": "@cerios/playwright-step-decorator",
	"version": "2.2.2",
	"description": "A Playwright decorator for creating step-based tests",
	"keywords": [
		"decorator",
		"playwright",
		"step",
		"testing"
	],
	"homepage": "https://github.com/CeriosTesting/playwright-step-decorator#readme",
	"bugs": {
		"url": "https://github.com/CeriosTesting/playwright-step-decorator/issues"
	},
	"license": "MIT",
	"author": "Ronald Veth - Cerios",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CeriosTesting/playwright-step-decorator.git"
	},
	"files": [
		"dist"
	],
	"type": "commonjs",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"default": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"changeset": "changeset",
		"check-exports": "attw --pack .",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint --type-aware --type-check",
		"release": "changeset publish",
		"test": "playwright test",
		"update-all-packages": "npm-check-updates -u && npm i",
		"version-packages": "changeset version",
		"version-packages:prepare-release": "npm run version-packages && npm run format"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@changesets/cli": "^3.0.3",
		"@playwright/test": "^1.63.0",
		"@types/node": "^26.6.3",
		"npm-check-updates": "^23.1.0",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.85.0",
		"oxlint-tsgolint": "^7.0.2003",
		"ts-node": "^10.9.2",
		"tsdown": "^0.23.0"
	},
	"peerDependencies": {
		"@playwright/test": "^1.51.0",
		"typescript": ">=5.0.2 <8"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	}
}
